<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit User</title>
</head>

<body>

  <h1>Edit User</h1>

  <form action="/users/<%= user.id %>?_method=PUT" method="POST">

    <div>
      <label for="name">Name</label>

      <input
        type="text"
        id="name"
        name="name"
        value="<%= user.name %>"
        required
      >
    </div>

    <br>

    <div>
      <label for="email">Email</label>

      <input
        type="email"
        id="email"
        name="email"
        value="<%= user.email %>"
        required
      >
    </div>

    <br>

    <button type="submit">
      Update User
    </button>

  </form>

  <br>

  <a href="/">
    Back
  </a>

</body>
</html>
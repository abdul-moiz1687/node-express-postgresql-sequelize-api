<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>User Management</title>
</head>

<body>

  <h1>User Management</h1>

  <h2>Create User</h2>

  <form action="/" method="POST">

    <div>
      <label for="name">Name:</label>
      <input
        type="text"
        id="name"
        name="name"
        required
      >
    </div>

    <br>

    <div>
      <label for="email">Email:</label>
      <input
        type="email"
        id="email"
        name="email"
        required
      >
    </div>

    <br>

    <button type="submit">Create User</button>

  </form>

  <hr>

  <h2>Users</h2>

  <% if (users.length === 0) { %>

    <p>No users found.</p>

  <% } else { %>

    <% users.forEach((user) => { %>

      <div>

        <h3><%= user.name %></h3>

        <p><%= user.email %></p>

        <a href="/users/<%= user.id %>/edit">
          Edit
        </a>

      </div>

      <hr>

    <% }) %>

  <% } %>

</body>
</html>